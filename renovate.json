{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "packageRules": [
    {
      "description": "The three Wazuh images must move together, and an upgrade needs a human review",
      "matchPackageNames": [
        "docker.io/wazuh/wazuh-manager",
        "docker.io/wazuh/wazuh-indexer",
        "docker.io/wazuh/wazuh-dashboard",
        "wazuh/wazuh-manager",
        "wazuh/wazuh-indexer",
        "wazuh/wazuh-dashboard"
      ],
      "groupName": "wazuh",
      "versioning": "semver",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The default agent version of the install script follows the manager image, in the wazuh group",
      "fileMatch": ["^scripts/install-agent\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) packageName=(?<packageName>\\S+)\\s*\\nVERSION=\"\\$\\{WAZUH_AGENT_VERSION:-(?<currentValue>[^}]+)\\}\""
      ],
      "depNameTemplate": "{{{packageName}}}",
      "versioningTemplate": "semver"
    }
  ]
}
