# Keep the events and the findings for LOG_RETENTION_DAYS days.
# The Wazuh ISM policies roll over at 20 GB only, so a small server never deletes anything,
# and they delete events one hour after the rollover. Here each stream rolls over every month,
# and an index is deleted once its newest line is older than the retention.
# Wazuh creates its policies only when they are missing, so our version stays after a restart.

import copy
import os
import sys
import time

import wazuh_api
from wazuh_api import api

wazuh_api.MEMORY_RETRY_SECONDS = 120

# One index per stream and per month: 16 streams stay far below the shard limit of a single node
ROLLOVER_AGE = "30d"
POLICIES = {
    "stream-events-policy": "wazuh-events-v5-*",
    "stream-findings-policy": "wazuh-findings-v5-*",
}


def log(message):
    print(message, file=sys.stderr)


def wait_ready():
    for _ in range(60):
        try:
            if api("GET", "_cluster/health").get("status") in ("green", "yellow"):
                return
        except RuntimeError:
            pass
        time.sleep(10)
    raise SystemExit("the indexer is not ready")


def retention_policy(policy, delete_after):
    """Return a copy of the policy with a monthly rollover and the deletion delay."""
    policy = copy.deepcopy(policy)
    states = {state["name"]: state for state in policy["states"]}
    hot = states[policy["default_state"]]
    for action in hot["actions"]:
        if "rollover" in action:
            # The size limits stay as a safety cap on a busy server
            action["rollover"]["min_index_age"] = ROLLOVER_AGE
    for transition in hot["transitions"]:
        if any("delete" in action for action in states[transition["state_name"]]["actions"]):
            # Counted from the rollover, when the index stops receiving lines
            transition["conditions"] = {"min_rollover_age": delete_after}
    # The Wazuh description tells about the 20 GB rollover, which is no longer the rule
    policy["description"] = f"Set by NS8: rolls over every {ROLLOVER_AGE} or at 20 GB, deletes {delete_after} after the rollover."
    keys = ("description", "default_state", "states", "ism_template", "error_notification")
    return {"policy": {key: policy[key] for key in keys if policy.get(key) is not None}}


def apply_to_existing(policy_id, pattern, seq_no):
    """Attach the current version of the policy to the indices that miss it."""
    # The data stream name expands to its hidden backing indices
    explain = api("GET", f"_plugins/_ism/explain/{pattern}")
    if "error" in explain:
        raise SystemExit(f"{policy_id}: {explain['error']}")
    updated = 0
    for name, info in explain.items():
        if not isinstance(info, dict):
            continue
        managed_by = info.get("index.plugins.index_state_management.policy_id")
        if managed_by == policy_id:
            # No version yet: the index is starting and reads the current policy
            if info.get("policy_seq_no") in (seq_no, None):
                continue
            # A change of policy waits for the end of the current action, and a rollover that is not
            # due never ends: the index is attached again so it starts with the new conditions.
            # A rolled over index skips the rollover and goes straight to the deletion check.
            api("POST", f"_plugins/_ism/remove/{name}")
        elif managed_by is not None:
            continue
        # An index without policy comes from a backup: the policy only catches new indices
        answer = api("POST", f"_plugins/_ism/add/{name}", {"policy_id": policy_id})
        if answer.get("failures"):
            raise SystemExit(f"{name}: {answer.get('failed_indices', answer)}")
        updated += 1
    log(f"{policy_id}: {updated} existing indices updated")


days = int(os.environ.get("LOG_RETENTION_DAYS", "365"))
wait_ready()

for policy_id, pattern in POLICIES.items():
    current = api("GET", f"_plugins/_ism/policies/{policy_id}")
    if "policy" not in current:
        raise SystemExit(f"{policy_id}: {current.get('error', current)}")
    wanted = retention_policy(current["policy"], f"{days}d")
    seq_no = current["_seq_no"]
    if wanted["policy"] != {key: current["policy"].get(key) for key in wanted["policy"]}:
        answer = api("PUT", f"_plugins/_ism/policies/{policy_id}"
                     f"?if_seq_no={current['_seq_no']}&if_primary_term={current['_primary_term']}", wanted)
        if "_seq_no" not in answer:
            raise SystemExit(f"{policy_id}: {answer.get('error', answer)}")
        seq_no = answer["_seq_no"]
        log(f"{policy_id}: deletion {days} days after the monthly rollover")
    apply_to_existing(policy_id, pattern, seq_no)
