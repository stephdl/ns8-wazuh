# Send the new findings to the export endpoint (--export) or notify them (--email). --email covers
# every notification channel, email, Telegram, ntfy, Mattermost and Nextcloud Talk: the admin gets a summary
# of the new findings, and each customer its logins from outside its allowed zones, at its own addresses and
# Telegram chat.
#
# A cursor file keeps the position of the last finding sent, so a stopped pod, a failed
# delivery or a slow detector loses nothing: the next run starts after the cursor and
# catches up. The cursor moves only after a successful delivery, so a finding may be sent
# twice after a partial failure, never zero times. Each channel has its own cursor: one that
# is down never makes another one send twice. A notification channel catches up one day at most.

import fcntl
import json
import os
import re
import smtplib
import ssl
import sys
import textwrap
import urllib.request
from collections import Counter
from datetime import datetime, timedelta, timezone
from email.message import EmailMessage

import agent

import wazuh_mattermost
import wazuh_ntfy
import wazuh_secrets
import wazuh_talk
import wazuh_telegram
import wazuh_zones
from wazuh_api import api
from wazuh_noise import NOISE

INDICES = "wazuh-findings-v5-*"
PAGE = 500
EXPORT_BATCH = 100
# A finding becomes searchable a little after its @timestamp: leave the last minute for the next run
SETTLE = timedelta(minutes=1)
LEVELS = ["informational", "low", "medium", "high", "critical"]
ZONE_TITLE = "NS8 login from outside the allowed zones"
ZONE_SEEN_FILE = "login-zone-alerts.json"
# Apart from the customer one, and one per channel: each reports a user, address and service once a day on its own
ZONE_ADMIN_SEEN_FILE = "login-zone-admin.json"
ZONE_TELEGRAM_SEEN_FILE = "login-zone-alerts-telegram.json"
ZONE_ADMIN_TELEGRAM_SEEN_FILE = "login-zone-admin-telegram.json"
ZONE_ADMIN_NTFY_SEEN_FILE = "login-zone-admin-ntfy.json"
ZONE_ADMIN_MATTERMOST_SEEN_FILE = "login-zone-admin-mattermost.json"
# The target of a webhook without a channel of its own: no channel name can start with #
WEBHOOK_CHANNEL = "#webhook"
ZONE_ADMIN_TALK_SEEN_FILE = "login-zone-admin-talk.json"
# A traveling user logs in again every few minutes: one email a day per user, address and service.
# The address, not only the country: a second attacker in the same country must not go unseen.
# The service: a stolen password used on one more application must show
ZONE_REPEAT = timedelta(days=1)
# A channel down for days would flood its chat when it comes back: the older findings are only counted
MAX_CATCH_UP = timedelta(days=1)
# The logins of the last day, where the zone table lists every application a user reached
LOGINS_DASHBOARD = "/app/dashboards#/view/ns8-logins?_g=(time:(from:now-24h,to:now))"


def log(message):
    print(message, file=sys.stderr)


def iso(moment):
    return moment.strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


class Cursor:
    """Position of the last finding sent: its @timestamp and the ids sent at that same time."""

    def __init__(self, path):
        self.path = path

    def load(self):
        try:
            with open(self.path) as f:
                data = json.load(f)
            return data["ts"], set(data["ids"])
        except (FileNotFoundError, ValueError, KeyError):
            # First run: start now, never send the whole history
            return iso(datetime.now(timezone.utc) - SETTLE), set()

    def save(self, ts, ids):
        tmp = self.path + ".new"
        with open(tmp, "w") as f:
            json.dump({"ts": ts, "ids": sorted(ids)}, f)
        os.replace(tmp, self.path)

    def forget(self):
        if os.path.exists(self.path):
            os.remove(self.path)


def catch_up(cursor, filters, must_not):
    """Load the cursor, moved to a day ago at most. Return the count of the findings skipped that way."""
    ts, ids = cursor.load()
    start = iso(datetime.now(timezone.utc) - MAX_CATCH_UP)
    # Compared on the seconds: the fraction of an @timestamp may have more digits than iso() writes
    if ts[:19] >= start[:19]:
        return ts, ids, 0
    query = {"bool": {
        "filter": [{"range": {"@timestamp": {"gte": ts, "lt": start}}}] + filters,
        "must_not": must_not + ([{"ids": {"values": sorted(ids)}}] if ids else []),
    }}
    answer = api("POST", f"{INDICES}/_count", {"query": query})
    if "count" not in answer:
        raise RuntimeError(f"count failed: {json.dumps(answer)[:300]}")
    return start, set(), answer["count"]


def pages(cursor_ts, cursor_ids, filters, must_not):
    """Yield the pages of findings after the cursor, oldest first, up to the settle time."""
    until = iso(datetime.now(timezone.utc) - SETTLE)
    ts, ids = cursor_ts, set(cursor_ids)
    while True:
        query = {"bool": {
            "filter": [{"range": {"@timestamp": {"gte": ts, "lte": until}}}] + filters,
            "must_not": must_not + ([{"ids": {"values": sorted(ids)}}] if ids else []),
        }}
        answer = api("POST", f"{INDICES}/_search", {"size": PAGE, "sort": [{"@timestamp": "asc"}], "query": query})
        if "hits" not in answer:
            raise RuntimeError(f"search failed: {json.dumps(answer)[:300]}")
        hits = answer["hits"]["hits"]
        if not hits:
            return
        last = hits[-1]["_source"]["@timestamp"]
        # Findings at the same millisecond as the last one are excluded by id at the next page
        ids = (ids if last == ts else set()) | {h["_id"] for h in hits if h["_source"]["@timestamp"] == last}
        ts = last
        yield hits, ts, ids
        if len(hits) < PAGE:
            return


def post(url, token, hits):
    body = json.dumps({"source": "ns8-wazuh", "host": os.environ.get("TRAEFIK_HOST", ""), "findings": hits}).encode()
    request = urllib.request.Request(url, data=body, method="POST", headers={"Content-Type": "application/json"})
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    with urllib.request.urlopen(request, timeout=30) as answer:
        if not 200 <= answer.status < 300:
            raise RuntimeError(f"the endpoint answered {answer.status}")


def export(cursor):
    url = os.environ.get("EXPORT_URL", "")
    if not url:
        cursor.forget()
        return 0
    token = wazuh_secrets.read(os.environ.get("EXPORT_SECRETS", "secrets/export.env"), "EXPORT_TOKEN")
    ts, ids = cursor.load()
    sent = 0
    for hits, ts, ids in pages(ts, ids, [], []):
        for start in range(0, len(hits), EXPORT_BATCH):
            post(url, token, hits[start:start + EXPORT_BATCH])
        cursor.save(ts, ids)
        sent += len(hits)
    # Also on a quiet first run: the next run must start from here, not from its own now
    cursor.save(ts, ids)
    if sent:
        log(f"{sent} findings exported")
    return 0


def send_mail(smtp, sender, recipients, subject, text):
    message = EmailMessage()
    message["From"] = sender
    message["To"] = ", ".join(recipients)
    message["Subject"] = subject
    message.set_content(text)
    context = ssl.create_default_context()
    if not smtp["tls_verify"]:
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
    if smtp["encrypt_smtp"] == "tls":
        client = smtplib.SMTP_SSL(smtp["host"], smtp["port"], timeout=30, context=context)
    else:
        client = smtplib.SMTP(smtp["host"], smtp["port"], timeout=30)
    with client:
        if smtp["encrypt_smtp"] == "starttls":
            client.starttls(context=context)
        if smtp["username"]:
            client.login(smtp["username"], smtp["password"])
        client.send_message(message)


# The Wazuh titles end with what they are about: "System service stopped - backup12",
# "User account wztest-a deleted". Grouped on the rest, the details listed below it.
ACCOUNT_TITLE = re.compile(r"^(New user account|User account|Group) (\S*) ?(created|deleted|modified)$")
VULNERABILITY_TITLE = re.compile(r"^(Wazuh VD) - Vulnerability (\S+) (detected|remediated)$")
DETAILS_SHOWN = 10
DETAIL_LENGTH = 60


def split_title(title):
    """Return the title without its subject, and the subject, empty when there is none."""
    match = ACCOUNT_TITLE.match(title) or VULNERABILITY_TITLE.match(title)
    if match:
        return f"{match.group(1)} {match.group(3)}", match.group(2)
    if " - " in title:
        # "Wazuh FIM - File deleted - /boot/x": the last part is the subject
        head, detail = title.rsplit(" - ", 1)
        return head, detail.strip()
    return title, ""


def summary_lines(found):
    """One line per kind of finding with its count, and the subjects it is about."""
    groups = {}
    for title, count in found.items():
        head, detail = split_title(title)
        total, details = groups.setdefault(head, [0, Counter()])
        groups[head][0] = total + count
        if len(detail) > DETAIL_LENGTH:
            detail = detail[:DETAIL_LENGTH - 3] + "..."
        details[detail or "unnamed"] += count
    lines = []
    for head, (count, details) in sorted(groups.items(), key=lambda g: (-g[1][0], g[0])):
        lines.append(f"  {count} x {head}")
        shown = [f"{d} ({n})" if n > 1 else d for d, n in sorted(details.items(), key=lambda x: (-x[1], x[0]))]
        # A title without a subject needs no detail line
        if list(details) != ["unnamed"]:
            more = len(shown) - DETAILS_SHOWN
            text = ", ".join(shown[:DETAILS_SHOWN]) + (f" and {more} more" if more > 0 else "")
            lines += textwrap.wrap(text, width=76, initial_indent="      ", subsequent_indent="      ",
                                   break_long_words=False, break_on_hyphens=False)
    return lines


# A message is a list of lines, each a kind and its text, so that each channel renders it its own way
def as_text(lines):
    return "\n".join(f"{line[1]}: {line[2]}" if line[0] == "link" else line[1] for line in lines)


def as_html(lines):
    escape = wazuh_telegram.escape
    rendered = {"head": lambda line: f"<b>{escape(line[1])}</b>",
                "text": lambda line: escape(line[1]),
                "link": lambda line: f'<a href="{escape(line[2])}">{escape(line[1])}</a>'}
    return "\n".join(rendered[line[0]](line) for line in lines)


MARKDOWN_SPECIAL = re.compile(r"([\\`*_\[\]<>#|~])")


def as_markdown(lines):
    # Indented lines would turn into code blocks, and single line breaks into one paragraph:
    # each line is trimmed and ends with a hard break instead. The details under a count are in italics
    escape = lambda text: MARKDOWN_SPECIAL.sub(r"\\\1", text.strip())
    rendered = {"head": lambda line: f"**{escape(line[1])}**",
                "text": lambda line: f"_{escape(line[1])}_" if line[1].startswith("      ") else escape(line[1]),
                "link": lambda line: f"[{escape(line[1])}]({line[2]})"}
    return "  \n".join(rendered[line[0]](line) for line in lines)


def mailer():
    """Deliver by email, or None without the cluster smarthost."""
    host = os.environ.get("TRAEFIK_HOST", "")
    smtp = agent.get_smarthost_settings(agent.redis_connect(use_replica=True))
    if not (host and smtp["enabled"] and smtp["host"]):
        return None
    sender = os.environ.get("NOTIFY_SENDER", "") or f"wazuh@{host}"
    return lambda recipients, subject, lines, level=None: send_mail(smtp, sender, recipients, subject,
                                                                    as_text(lines))


def telegram():
    """Deliver to a Telegram chat, or None without the bot token."""
    bot = wazuh_telegram.token()
    host = os.environ.get("TRAEFIK_HOST", "")
    if not (host and bot):
        return None
    # A chat may get the alerts of several servers: the email names this one in its subject
    return lambda chat_id, subject, lines, level=None: wazuh_telegram.send(
        bot, chat_id, as_html([("text", f"Wazuh on {host}")] + lines))


def ntfy():
    """Publish to an ntfy topic: the access token is optional, a server may let anybody publish."""
    url = os.environ.get("NTFY_URL", "") or "https://ntfy.sh"
    host = os.environ.get("TRAEFIK_HOST", "")
    if not host:
        return None
    # The title names the server, the priority follows the highest level, a tap opens the dashboard
    return lambda topic, subject, lines, level="medium": wazuh_ntfy.send(
        url, wazuh_ntfy.token(), topic, subject, as_markdown(lines), level, f"https://{host}/")


def mattermost():
    """Post to a Mattermost incoming webhook: the webhook picks the channel unless one is set."""
    webhook = wazuh_mattermost.webhook()
    host = os.environ.get("TRAEFIK_HOST", "")
    if not (host and webhook):
        return None
    # The border colour follows the highest level, the title opens the dashboard
    return lambda channel, subject, lines, level="medium": wazuh_mattermost.send(
        webhook, subject, as_markdown(lines), level, f"https://{host}/",
        "" if channel == WEBHOOK_CHANNEL else channel, os.environ.get("MATTERMOST_USERNAME", ""))


def talk():
    """Post to a Nextcloud Talk conversation through the bot whose secret is stored."""
    url = os.environ.get("TALK_URL", "")
    bot_secret = wazuh_talk.secret()
    host = os.environ.get("TRAEFIK_HOST", "")
    if not (url and host and bot_secret):
        return None
    # The first character follows the highest level, the dashboard link is the last line
    return lambda conversation, subject, lines, level="medium": wazuh_talk.send(
        url, conversation, bot_secret, subject, as_markdown(lines), level)


def admin_report(cursor, seen_file, target, deliver):
    """Send the admin a summary of the new findings and of the logins from outside the allowed zones."""
    host = os.environ.get("TRAEFIK_HOST", "")
    if not (target and deliver):
        cursor.forget()
        return
    min_level = os.environ.get("NOTIFY_MIN_LEVEL", "medium")
    levels = LEVELS[LEVELS.index(min_level):] if min_level in LEVELS else LEVELS[2:]

    zone_settings = wazuh_zones.load()["customers"]
    seen = SeenLogins(seen_file)
    counts = Counter()
    zone_logins = {}
    top = 0
    # The zone logins come whatever the minimum level: the customers get them, so must the admin
    wanted = [{"bool": {"should": [{"terms": {"wazuh.rule.level": levels}},
                                   {"match_phrase": {"wazuh.rule.title": ZONE_TITLE}}], "minimum_should_match": 1}}]
    ts, ids, skipped = catch_up(cursor, wanted, NOISE)
    for hits, ts, ids in pages(ts, ids, wanted, NOISE):
        for hit in hits:
            source = hit["_source"]["wazuh"]
            wazuh_agent = source.get("agent", {})
            customer = wazuh_zones.customer_of(wazuh_agent.get("groups"))
            title = source.get("rule", {}).get("title", "?")
            level = source.get("rule", {}).get("level")
            # A login from outside the zones counts as high whatever its rule says
            top = max(top, LEVELS.index("high") if title == ZONE_TITLE else
                      LEVELS.index(level) if level in LEVELS else 0)
            if title == ZONE_TITLE:
                if seen.first(zone_key(customer, hit["_source"])):
                    zone_logins.setdefault(customer, []).append(zone_line(hit["_source"]))
                continue
            counts[(customer, wazuh_agent.get("name", "?"), title)] += 1
    findings = sum(counts.values())
    logins = sum(len(z) for z in zone_logins.values())
    if findings or logins or skipped:
        summary = [plural(logins, "login") + " from outside the allowed zones" if logins else "",
                   plural(findings, "new finding") if findings else ""]
        summary = " and ".join(part for part in summary if part) or "findings not sent during an outage"
        # One block per customer and agent, one line per kind of finding with a count, instead of one line per finding
        lines = [("head", f"{summary[0].upper()}{summary[1:]}."), ("text", "")]
        customers = sorted({c for c, _, _ in counts} | set(zone_logins))
        for customer in customers:
            if customer:
                lines += [("head", f"Customer {customer}"), ("text", "")]
            elif len(customers) > 1:
                lines += [("head", "No customer"), ("text", "")]
            # Apart from the other findings and in full: the detail is the alert, a cut line would hide it
            if customer in zone_logins:
                zones = zone_settings.get(customer, {}).get("zones", [])
                lines += [("head", "Logins from outside the allowed zones"),
                          ("text", f"  Allowed: {', '.join(wazuh_zones.zone_name(z) for z in zones)}")]
                lines += [("text", f"  {line}") for line in zone_logins[customer]]
                lines.append(("text", ""))
            for agent_name in sorted({a for c, a, _ in counts if c == customer}):
                lines.append(("head", agent_name))
                lines += [("text", line) for line in summary_lines(Counter({r: n for (c, a, r), n in counts.items()
                                                                            if c == customer and a == agent_name}))]
                lines.append(("text", ""))
        if skipped:
            lines += [("text", f"{plural(skipped, 'older finding')} not sent: this channel was down for more"
                               " than a day."), ("text", "")]
        lines.append(("link", "Open the dashboard", f"https://{host}/"))
        deliver(target, f"Wazuh: {summary} on {host}", lines, LEVELS[top])
        log(f"summary sent, {findings} findings, {logins} zone logins, {skipped} skipped")
    # Saved after the delivery only: a failed one is sent again at the next run
    seen.save()
    cursor.save(ts, ids)


def zone_report(cursor, seen_file, target, deliver):
    """Send each customer its logins from outside its allowed zones, once a day per user, address and service.

    target gives the address or chat of a customer, empty when it gets nothing on this channel.
    """
    customers = {name: c for name, c in wazuh_zones.load()["customers"].items() if target(c)}
    host = os.environ.get("TRAEFIK_HOST", "")
    if not (deliver and customers):
        cursor.forget()
        return
    seen = SeenLogins(seen_file)

    filters = [{"match_phrase": {"wazuh.rule.title": ZONE_TITLE}}]
    ts, ids, skipped = catch_up(cursor, filters, [])
    if skipped:
        log(f"{skipped} zone logins older than a day skipped")
    alerts = {}
    for hits, ts, ids in pages(ts, ids, filters, []):
        for hit in hits:
            source = hit["_source"]
            customer = wazuh_zones.customer_of(source.get("wazuh", {}).get("agent", {}).get("groups"))
            key = zone_key(customer, source)
            if customer in customers and not seen.known(key):
                alerts.setdefault(customer, {}).setdefault(key, zone_line(source))
    failed = []
    for customer, logins in sorted(alerts.items()):
        zones = ", ".join(wazuh_zones.zone_name(z) for z in customers[customer].get("zones", []))
        lines = ([("head", f"Logins of {customer} from outside its allowed zones ({zones}):"), ("text", "")] +
                 [("text", line) for line in logins.values()] +
                 [("text", ""), ("text", "Each user, address and service is reported once a day."),
                  ("link", "Open the logins dashboard", f"https://{host}{LOGINS_DASHBOARD}")])
        # One customer whose chat or mailbox refuses must not hold back the others
        try:
            deliver(target(customers[customer]),
                    f"Wazuh: {plural(len(logins), 'login')} from outside the allowed zones ({customer})", lines)
        except wazuh_telegram.TelegramError as error:
            if not error.lasting:
                log(f"zone alert to {customer} failed, retried at the next run: {error}")
                failed.append(customer)
                continue
            # Retrying cannot help until the chat is fixed: skipped, so the others move on
            log(f"zone alert to {customer} dropped, check its Telegram chat: {error}")
            continue
        except Exception as error:
            log(f"zone alert to {customer} failed: {error}")
            failed.append(customer)
            continue
        # Saved per customer: the next run sends again only to those that failed
        seen.add(logins)
        seen.save()
        log(f"zone alert sent to {customer}, {len(logins)} logins")
    if failed:
        raise RuntimeError(f"zone alerts not sent to {', '.join(failed)}")
    cursor.save(ts, ids)


def zone_key(customer, source):
    return (f"{customer}:{source.get('user', {}).get('name', '?')}:{source.get('source', {}).get('ip', '?')}"
            f":{source.get('service', {}).get('type', '?')}")


def plural(count, word):
    return f"{count} {word}" + ("" if count == 1 else "s")


def zone_line(source):
    """2026-10-16 07:35 UTC  root on ssh from 86.201.48.4 (Paris, France), server mail1"""
    when = source["@timestamp"][:16].replace("T", " ")
    server = source.get("wazuh", {}).get("agent", {}).get("name", "?")
    return f"{when} UTC  {zone_detail(source)}, server {server}"


def zone_detail(source):
    """root on ssh from 86.201.48.4 (Paris, France)"""
    geo = source.get("source", {}).get("geo", {})
    place = ", ".join(p for p in (geo.get("city_name"), geo.get("country_name") or geo.get("country_iso_code")) if p)
    return (f"{source.get('user', {}).get('name', '?')} on {source.get('service', {}).get('type', '?')}"
            f" from {source.get('source', {}).get('ip', '?')} ({place or '?'})")


class SeenLogins:
    """Users already reported per customer, address and service, forgotten after a day."""

    def __init__(self, path):
        self.path = path
        now = datetime.now(timezone.utc).timestamp()
        try:
            with open(path) as f:
                self.seen = {k: t for k, t in json.load(f).items() if now - t < ZONE_REPEAT.total_seconds()}
        except (FileNotFoundError, ValueError):
            self.seen = {}
        self.now = now

    def known(self, key):
        return key in self.seen

    def first(self, key):
        if key in self.seen:
            return False
        self.seen[key] = self.now
        return True

    def add(self, keys):
        self.seen.update({key: self.now for key in keys})

    def save(self):
        tmp = self.path + ".new"
        with open(tmp, "w") as f:
            json.dump(self.seen, f)
        os.replace(tmp, self.path)


def main():
    output = (sys.argv[1:] or [""])[0].lstrip("-")
    if output not in ("export", "email"):
        raise SystemExit("usage: send-findings --export|--email")
    # A run that lasts longer than the timer period must not overlap with the next one
    with open(f"send-findings-{output}.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("previous run still going")
            return 0
        if output == "export":
            return export(Cursor("send-findings-export.cursor"))
        recipients = [r for r in os.environ.get("NOTIFY_RECIPIENTS", "").split(",") if r]
        # Before the switch existed, a recipient was enough to send emails
        if os.environ.get("NOTIFY_ENABLED", str(bool(recipients))) != "True":
            recipients = []
        # The bot switch stops every chat, the admin one and those of the customers
        bot_on = os.environ.get("TELEGRAM_ENABLED") == "True"
        admin_on = bot_on and os.environ.get("TELEGRAM_ADMIN_ENABLED") == "True"
        chat_id = os.environ.get("TELEGRAM_CHAT_ID", "") if admin_on else ""

        def customer_chat(customer):
            return customer.get("telegram_chat_id", "") if bot_on and customer.get("telegram_enabled") else ""

        status = 0
        try:
            mail = mailer()
        except Exception as error:
            log(f"email failed: {error}")
            mail, status = None, 1
        chat = telegram() if bot_on else None
        topic = os.environ.get("NTFY_TOPIC", "") if os.environ.get("NTFY_ENABLED") == "True" else ""
        team_chat = mattermost() if os.environ.get("MATTERMOST_ENABLED") == "True" else None
        conversation = os.environ.get("TALK_CONVERSATION", "") if os.environ.get("TALK_ENABLED") == "True" else ""
        runs = [
            ("admin email", lambda: admin_report(Cursor("send-findings-email.cursor"), ZONE_ADMIN_SEEN_FILE,
                                                 recipients, mail)),
            ("customer email", lambda: zone_report(Cursor("send-findings-zones.cursor"), ZONE_SEEN_FILE,
                                                   lambda c: c.get("recipients"), mail)),
            ("admin telegram", lambda: admin_report(Cursor("send-findings-telegram.cursor"),
                                                    ZONE_ADMIN_TELEGRAM_SEEN_FILE, chat_id, chat)),
            ("customer telegram", lambda: zone_report(Cursor("send-findings-zones-telegram.cursor"),
                                                      ZONE_TELEGRAM_SEEN_FILE, customer_chat, chat)),
            ("admin ntfy", lambda: admin_report(Cursor("send-findings-ntfy.cursor"),
                                                ZONE_ADMIN_NTFY_SEEN_FILE, topic, ntfy() if topic else None)),
            ("admin mattermost", lambda: admin_report(Cursor("send-findings-mattermost.cursor"),
                                                      ZONE_ADMIN_MATTERMOST_SEEN_FILE,
                                                      os.environ.get("MATTERMOST_CHANNEL", "") or WEBHOOK_CHANNEL,
                                                      team_chat)),
            ("admin talk", lambda: admin_report(Cursor("send-findings-talk.cursor"), ZONE_ADMIN_TALK_SEEN_FILE,
                                                conversation, talk() if conversation else None)),
        ]
        # A channel that fails must not stop the others: it tries again at the next run
        for name, run in runs:
            try:
                run()
            except Exception as error:
                log(f"{name} failed: {error}")
                status = 1
        return status


sys.exit(main())
