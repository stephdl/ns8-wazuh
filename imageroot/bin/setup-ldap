# Apply the NS8 user domain to the indexer security configuration.
# The documents are streamed through stdin into the container, so the bind
# password never touches the host disk.

import os

import agent
from agent.ldapproxy import Ldapproxy

import wazuh_security
from wazuh_securityadmin import apply_document, read_default, wait_indexer

wait_indexer()

ldap_domain = os.environ.get("LDAP_DOMAIN", "")
admin_group = os.environ.get("LDAP_ADMIN_GROUP", "")

domain = None
users_filter = ""
if ldap_domain:
    proxy = Ldapproxy()
    domain = proxy.get_domain(ldap_domain)
    agent.assert_exp(domain is not None, f"user domain {ldap_domain} not found")
    agent.bind_user_domains([ldap_domain])
    users_filter = proxy.get_ldap_users_search_filter_clause(ldap_domain)

apply_document(wazuh_security.build_security_config(read_default("config.yml", "config"), domain, users_filter), "config")
apply_document(wazuh_security.build_roles_mapping(read_default("roles_mapping.yml", "all_access"), admin_group if domain else None), "rolesmapping")
