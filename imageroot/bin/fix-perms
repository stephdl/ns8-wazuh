#!/bin/bash

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

# The Wazuh images drop to uid 101 inside the pod. The core runs "chown -R" on the module
# directory at each update and it fails on a file owned by a subuid, so nothing under state/
# may belong to uid 101. So the certificates and their private keys stay owned by the module and
# readable by all: uid 101 reads them as "other". Only the module reaches them, its home is 0700.

set -e
exec 1>&2

cd "${AGENT_STATE_DIR}"
chmod 0644 certs/*.pem

# Rocky keeps vm.max_map_count at 65530 and a rootless module cannot raise it.
# Below the 262144 the indexer expects, stop it from mapping the index files in memory.
if (( $(cat /proc/sys/vm/max_map_count) < 262144 )); then
    echo "node.store.allow_mmap=false" > indexer-tuning.env
else
    : > indexer-tuning.env
fi

# The snapshots volume belongs to uid 101: wazuh-indexer.service fixes it once the container runs
podman volume exists wazuh-snapshots || podman volume create wazuh-snapshots
