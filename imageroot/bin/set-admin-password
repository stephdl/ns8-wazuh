#!/usr/bin/env python3

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

# Change the password of the dashboard administrator without restarting anything.
# The new password is read from the first line of stdin, never from the command line.
#
# 1. hash it in the indexer container, 2. apply the new hash with securityadmin.sh,
# 3. check that the new password logs in, and put the old hash back if it does not,
# 4. keep the secret file in step, because the indexer resolves it again at each start.

import os
import sys

import agent

from wazuh_api import curl_quote
from wazuh_password import password_error
from wazuh_securityadmin import apply_document, podman_exec, read_default, wait_indexer

SECRET_FILE = os.environ.get("INDEXER_SECRETS", "secrets/indexer.env")
HASH_TOOL = "/usr/share/wazuh-indexer/plugins/opensearch-security/tools/hash.sh"
KEY = "WAZUH_INDEXER_ADMIN_PASSWORD"

password = sys.stdin.readline().rstrip("\n")
broken_rule = password_error(password)
agent.assert_exp(broken_rule is None, f"the password is refused: {broken_rule}")


def hash_password(value):
    # The password goes through stdin and an environment variable: no command line shows it
    proc = podman_exec([
        "env", "OPENSEARCH_JAVA_HOME=/usr/share/wazuh-indexer/jdk",
        "sh", "-c", f'IFS= read -r NEW_PW; export NEW_PW; exec {HASH_TOOL} -env NEW_PW',
    ], value + "\n")
    lines = [line for line in proc.stdout.splitlines() if line.startswith("$2")]
    agent.assert_exp(proc.returncode == 0 and lines, "cannot hash the password")
    return lines[-1]


def logs_in(value):
    config = f'user = "admin:{curl_quote(value)}"\nurl = "https://localhost:9200/"\n'
    proc = podman_exec(["curl", "-sk", "-o", "/dev/null", "-w", "%{http_code}", "-K", "-"], config)
    return proc.stdout.strip() == "200"


def read_secret_file():
    with open(SECRET_FILE) as f:
        return f.read().splitlines()


def write_secret_file(value):
    lines = [f"{KEY}={value}" if line.startswith(f"{KEY}=") else line for line in read_secret_file()]
    tmp = SECRET_FILE + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, SECRET_FILE)


old_password = next((line.split("=", 1)[1] for line in read_secret_file() if line.startswith(f"{KEY}=")), "")

wait_indexer()
if logs_in(password):
    print("the administrator already has this password", file=sys.stderr)
    write_secret_file(password)
    sys.exit(0)

users = read_default("internal_users.yml", "admin")
previous_hash = users["admin"]["hash"]
users["admin"]["hash"] = hash_password(password)
apply_document(users, "internalusers")

if not logs_in(password):
    # Never leave the administrator without a working password
    users["admin"]["hash"] = previous_hash
    apply_document(users, "internalusers")
    agent.assert_exp(False, "the new password does not log in, the previous one was restored")

write_secret_file(password)
agent.assert_exp(not old_password or not logs_in(old_password) or old_password == password,
                 "the previous password still logs in")
print("administrator password changed", file=sys.stderr)
