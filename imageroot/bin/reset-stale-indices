# Bring the state indices to the mapping of the template of this Wazuh version.
# A template applies only when an index is created, so after an image update an old index keeps
# the old mapping. Its mapping is strict: the manager then fails to index the new fields, and an
# agent whose inventory cannot be stored stops all its synchronization.
# New fields are added in place and the documents stay. A field that changed its type cannot be
# changed in place: that index is created again, and the agents report its states at their next sync.

import sys

import wazuh_api
from wazuh_api import api, wait_indexer

wazuh_api.MEMORY_RETRY_SECONDS = 120

PATTERNS = "wazuh-states-*,wazuh-agent-*"


def flatten(properties, prefix=""):
    fields = {}
    for name, spec in properties.items():
        path = prefix + name
        if "properties" in spec:
            fields[path] = "object"
            fields.update(flatten(spec["properties"], path + "."))
        else:
            fields[path] = spec.get("type", "object")
    return fields


def compare(index):
    """Return the template properties, the missing fields and the fields of another type."""
    live = api("GET", f"{index}/_mapping")
    if "error" in live:
        raise RuntimeError(live["error"].get("reason") or live["error"])
    live = flatten(live[index]["mappings"].get("properties", {}))
    template = api("POST", f"_index_template/_simulate_index/{index}")
    if "error" in template or "template" not in template:
        # No template of this version matches the index: nothing to compare with
        return {}, [], []
    properties = template["template"]["mappings"].get("properties", {})
    wanted = flatten(properties)
    missing = [path for path in wanted if path not in live]
    changed = [f"{path} ({live[path]} instead of {kind})"
               for path, kind in wanted.items() if path in live and live[path] != kind]
    return properties, missing, changed


def recreate(index):
    answer = api("DELETE", index)
    if "error" in answer:
        sys.exit(f"cannot delete {index}: {answer['error']}")
    # The manager may not create an index, the indexer does it only at its start: create it now from the template
    answer = api("PUT", index)
    if "error" in answer:
        sys.exit(f"cannot create {index} again: {answer['error']}")


wait_indexer()
indices = api("GET", f"_cat/indices/{PATTERNS}?format=json&h=index&expand_wildcards=open")
if isinstance(indices, dict) and "error" in indices:
    sys.exit(f"cannot list the indices: {indices['error']}")
for index in sorted(item["index"] for item in indices):
    properties, missing, changed = compare(index)
    if changed:
        print(f"{index}: field types changed, created again: {', '.join(changed[:5])}", file=sys.stderr)
        recreate(index)
    elif missing:
        answer = api("PUT", f"{index}/_mapping", {"properties": properties})
        if "error" in answer:
            print(f"{index}: new fields refused ({answer['error'].get('reason')}), created again", file=sys.stderr)
            recreate(index)
        else:
            print(f"{index}: new fields added: {', '.join(missing[:5])}", file=sys.stderr)
