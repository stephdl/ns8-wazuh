# Use the certificate of Traefik for the agent listener, if it is valid for our host name.
# Without Let's Encrypt or an uploaded certificate, Traefik serves its default one: the
# manager refuses the enrollment tokens with it, so the internal certificate stays in place.
#
# Exit status: 0 when the certificate was replaced, 3 when the current one was kept.

import os
import re
import subprocess
import sys

CERT = "certs/remoted.pem"
KEY = "certs/remoted-key.pem"
NEW_CERT = "certs/remoted.new.pem"
NEW_KEY = "certs/remoted-key.new.pem"

host = os.environ.get("TRAEFIK_HOST", "")
if not host:
    print("TRAEFIK_HOST is not set", file=sys.stderr)
    sys.exit(3)


def cleanup():
    for path in (NEW_CERT, NEW_KEY):
        if os.path.exists(path):
            os.remove(path)


def matches(name, wanted):
    if name == wanted:
        return True
    return name.startswith("*.") and wanted.split(".", 1)[-1] == name[2:]


os.makedirs("certs", exist_ok=True)
cleanup()
proc = subprocess.run(["get-certificate", f"--cert-file={NEW_CERT}", f"--key-file={NEW_KEY}", host])
if proc.returncode != 0 or not os.path.exists(NEW_CERT) or not os.path.exists(NEW_KEY):
    print("Traefik has no certificate for this host, the internal one is kept", file=sys.stderr)
    cleanup()
    sys.exit(3)

san = subprocess.run(["openssl", "x509", "-noout", "-ext", "subjectAltName", "-in", NEW_CERT],
                     capture_output=True, text=True).stdout
if not any(matches(name, host) for name in re.findall(r"DNS:([^,\s]+)", san)):
    print(f"The certificate of Traefik is not valid for {host}, the internal one is kept", file=sys.stderr)
    cleanup()
    sys.exit(3)

# A rename works even if the current file belongs to another uid, as the directory is ours
os.replace(NEW_KEY, KEY)
os.replace(NEW_CERT, CERT)
print(f"the agent listener uses the Traefik certificate of {host}", file=sys.stderr)
