# Runs after the backup: the backup tool keeps its own copy, free the space of the snapshot.
# A failure is not an error: the indexer may be stopped.

import sys

from wazuh_api import api

try:
    api("DELETE", "_snapshot/ns8/backup")
except RuntimeError as exc:
    print(f"snapshot not removed: {exc}", file=sys.stderr)
