# Run the NS8 rules on the events.
# The Content Manager registers our rules in Security Analytics, but it creates a detector
# only for the standard content: without one the rules never run and no finding appears.
# The script is idempotent and refreshes the rules of the detector, which change at each promotion.

import glob
import json
import os
import sys
import time

import wazuh_api
from wazuh_api import api

wazuh_api.MEMORY_RETRY_SECONDS = 120

SA = "_plugins/_security_analytics"
NAME = "ns8"
# Our decoders put every event in the applications category
INDEX = "wazuh-events-v5-applications"
CONTENT_DIR = os.environ.get("CONTENT_DIR", os.path.join(os.environ.get("AGENT_INSTALL_DIR", "."), "content"))


def log(message):
    print(message, file=sys.stderr)


def content_titles():
    """Return the titles of the enabled and of the disabled rules shipped with the module."""
    enabled, disabled = set(), set()
    for path in glob.glob(os.path.join(CONTENT_DIR, "rules", "*.json")):
        with open(path) as f:
            resource = json.load(f)["resource"]
        # Security Analytics does not carry the enabled flag of the Content Manager: the detector would still run them
        (enabled if resource.get("enabled", True) else disabled).add(resource["metadata"]["title"])
    return enabled, disabled


def our_rules(disabled):
    answer = api("POST", f"{SA}/rules/_search?pre_packaged=false", {"size": 500, "query": {"match_all": {}}})
    unique = {}
    for hit in answer.get("hits", {}).get("hits", []):
        source = hit["_source"]
        # The draft and test spaces hold copies too, only the promoted ones can run
        space = source.get("space")
        space = space.get("name") if isinstance(space, dict) else space
        if source.get("category") != NAME or space != "custom":
            continue
        if source.get("metadata", {}).get("title") in disabled:
            continue
        # The detector wants the id of the document of the Content Manager, not the id in Security Analytics
        unique[source.get("metadata", {}).get("title")] = source["document"]["id"]
    return unique


def find_detector():
    answer = api("POST", f"{SA}/detectors/_search", {"size": 200, "query": {"match_all": {}}})
    for hit in answer.get("hits", {}).get("hits", []):
        if hit["_source"].get("name") == NAME:
            return hit["_id"]
    return None


# The rules are registered a few seconds after the promotion. On an update the old ones are already
# there: wait for every rule of the module, or a new rule would miss the detector.
found = {}
enabled, disabled = content_titles()
for _ in range(30):
    found = our_rules(disabled)
    if enabled <= found.keys():
        break
    time.sleep(2)
if not found:
    sys.exit("no NS8 rule found in Security Analytics")
missing = enabled - found.keys()
if missing:
    log(f"Warning: rules not registered yet, the next configure-module adds them: {', '.join(sorted(missing))}")
rules = sorted(found.values())

detector = {
    "type": "detector",
    "name": NAME,
    "detector_type": NAME,
    "enabled": True,
    "schedule": {"period": {"interval": 1, "unit": "MINUTES"}},
    "inputs": [{"detector_input": {
        "description": "NS8 detection rules",
        "indices": [INDEX],
        "custom_rules": [{"id": rule_id} for rule_id in rules],
        "pre_packaged_rules": [],
    }}],
    "triggers": [],
}

detector_id = find_detector()
if detector_id and "--recreate" in sys.argv:
    # A restore swaps the events index under the detector: its monitor keeps the position it had in
    # the empty index and reads the whole history again, too slow to ever reach the new events.
    # A new detector starts at the end of the index.
    answer = api("DELETE", f"{SA}/detectors/{detector_id}")
    if "_id" not in answer:
        sys.exit(f"detector: {answer}")
    detector_id = None
if detector_id:
    answer = api("PUT", f"{SA}/detectors/{detector_id}", detector)
else:
    answer = api("POST", f"{SA}/detectors", detector)
if "_id" not in answer:
    sys.exit(f"detector: {answer}")
log(f"detector {NAME} with {len(rules)} rules: ok")
