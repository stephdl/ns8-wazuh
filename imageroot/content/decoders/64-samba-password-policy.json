{
  "resource": {
    "name": "decoder/ns8-samba-password-policy/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "Samba password policy change",
      "description": "The password policy of the domain changed through the NS8 interface or API",
      "author": "NethServer",
      "module": "samba",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "_line": "contains(\"action \\\"set-password-policy\\\" status is \\\"completed\\\"\")"
      }
    ],
    "normalize": [
      {
        "parse|_line": [
          "<~>task/module/<service.name>/<~>"
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "iam"
            ]
          },
          {
            "event.type": [
              "change"
            ]
          },
          {
            "event.action": "password-policy-changed"
          },
          {
            "event.outcome": "success"
          },
          {
            "service.type": "samba"
          }
        ]
      }
    ]
  }
}
