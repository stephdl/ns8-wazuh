{
  "resource": {
    "name": "decoder/ns8-sogo-login-failed/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "SOGo failed login",
      "description": "Wrong passwords on the SOGo web interface",
      "author": "NethServer",
      "module": "sogo",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "_line": "contains(\"SOGoRootPage Login from '\")"
      },
      {
        "_line": "contains(\"might not have worked\")"
      }
    ],
    "normalize": [
      {
        "parse|_line": [
          "<~>SOGoRootPage Login from '<source.ip>, <~>' for user '<user.name>' might not have worked<~>",
          "<~>SOGoRootPage Login from '<source.ip>' for user '<user.name>' might not have worked<~>"
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "authentication"
            ]
          },
          {
            "event.type": [
              "denied"
            ]
          },
          {
            "event.action": "logon-failed"
          },
          {
            "event.outcome": "failure"
          },
          {
            "process.name": "sogo"
          }
        ]
      }
    ]
  }
}
