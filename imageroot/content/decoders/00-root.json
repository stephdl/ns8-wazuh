{
  "resource": {
    "name": "decoder/ns8-root/0",
    "enabled": true,
    "metadata": {
      "title": "NS8 root decoder",
      "description": "Reads the journal lines sent by the Wazuh agent, as syslog text or as JSON from the ns8-journal command",
      "author": "NethServer",
      "module": "ns8",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "normalize": [
      {
        "map": [
          {
            "_ns8": "true"
          }
        ]
      },
      {
        "parse|event.original": [
          "wazuh: output: 'ns8-journal': <_nj_raw>",
          "<~>"
        ]
      },
      {
        "check": "exists($_nj_raw)",
        "map": [
          {
            "_nj": "parse_json($_nj_raw)"
          }
        ]
      },
      {
        "check": "exists($_nj.ns8_journal)",
        "map": [
          {
            "process.name": "$_nj.program"
          },
          {
            "message": "$_nj.message"
          },
          {
            "service.id": "$_nj.unit"
          },
          {
            "_line": "concat($_nj.program, '[', $_nj.pid, ']: ', $_nj.message)"
          }
        ]
      },
      {
        "check": "exists($_nj.ns8_journal) AND NOT string_equal($_nj.module, '')",
        "map": [
          {
            "orchestrator.namespace": "$_nj.module"
          }
        ]
      },
      {
        "check": "NOT exists($_nj.ns8_journal)",
        "map": [
          {
            "_line": "$event.original"
          }
        ]
      },
      {
        "check": "NOT exists($_nj.ns8_journal)",
        "parse|event.original": [
          "<~> <~> <~> <~> <process.name>[<~>]: <message>",
          "<~> <~> <~> <~> <process.name>: <message>",
          "<~>"
        ]
      }
    ]
  }
}
