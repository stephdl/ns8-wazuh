{
  "resource": {
    "name": "decoder/ns8-traefik-access/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "Traefik access log",
      "description": "HTTP requests received by the NS8 reverse proxy",
      "author": "NethServer",
      "module": "traefik",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "_line": "contains(\" - - [\")"
      }
    ],
    "normalize": [
      {
        "parse|_line": [
          "<~>: <source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~> \"<~>\" \"<_ua>\" <~> \"<service.name>@<~>\" <~>",
          "<~>: <source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~>"
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "web"
            ]
          },
          {
            "event.type": [
              "access"
            ]
          },
          {
            "service.type": "web"
          }
        ]
      },
      {
        "check": "exists($_ua) AND NOT string_equal($_ua, '-')",
        "map": [
          {
            "user_agent.original": "$_ua"
          }
        ]
      }
    ]
  }
}
