{
  "resource": {
    "name": "decoder/ns8-traefik-access/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "Web access log",
      "description": "HTTP requests of the NS8 reverse proxy, and of the nginx and apache sites behind it, which carry the user agent",
      "author": "NethServer",
      "module": "traefik",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "_line": "contains(\" - - [\")"
      }
    ],
    "normalize": [
      {
        "parse|_line": [
          "<~>: <source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~> \"<~>\" \"<_ua>\" <~> \"<service.name>@<~>\" <~>",
          "<~>: <source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~> \"<~>\" \"<_ua>\" <~>",
          "<~>: <source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~> \"<~>\" \"<_ua>\"",
          "<~>: <source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~>",
          "<source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~> \"<~>\" \"<_ua>\" <~>",
          "<source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~> \"<~>\" \"<_ua>\"",
          "<source.ip> - <~>\"<http.request.method> <url.path> <~>\" <http.response.status_code> <~>"
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "web"
            ]
          },
          {
            "event.type": [
              "access"
            ]
          },
          {
            "service.type": "web"
          }
        ]
      },
      {
        "check": "exists($_ua) AND NOT string_equal($_ua, '-')",
        "map": [
          {
            "user_agent.original": "$_ua"
          }
        ]
      },
      {
        "check": "exists($service.name)",
        "parse|service.name": [
          "<service.target.name>-https",
          "<service.target.name>-http",
          "<service.target.name>"
        ]
      },
      {
        "check": "starts_with($service.target.name, 'webserver')",
        "parse|service.target.name": [
          "webserver<~>-<_vhost>"
        ]
      },
      {
        "check": "exists($_vhost)",
        "map": [
          {
            "service.target.name": "$_vhost"
          }
        ]
      },
      {
        "check": "NOT exists($service.target.name) AND starts_with($wazuh.protocol.location, '/')",
        "map": [
          {
            "service.target.name": "$wazuh.agent.name"
          }
        ]
      },
      {
        "check": "NOT exists($service.target.name) AND NOT starts_with($orchestrator.namespace, 'traefik')",
        "map": [
          {
            "service.target.name": "$orchestrator.namespace"
          }
        ]
      }
    ]
  }
}
