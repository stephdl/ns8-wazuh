{
  "resource": {
    "name": "decoder/ns8-nextcloud-login-failed/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "Nextcloud failed login",
      "description": "Wrong passwords on the Nextcloud web interface, WebDAV and the sync clients",
      "author": "NethServer",
      "module": "nextcloud",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "event.original": "contains(\"Login failed: '\")"
      },
      {
        "event.original": "contains(\"Remote IP: '\")"
      }
    ],
    "normalize": [
      {
        "parse|event.original": [
          "<~>Login failed: '<user.name>' \\(Remote IP: '<source.ip>'\\)<~>"
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "authentication"
            ]
          },
          {
            "event.type": [
              "denied"
            ]
          },
          {
            "event.action": "logon-failed"
          },
          {
            "event.outcome": "failure"
          },
          {
            "process.name": "nextcloud"
          }
        ]
      }
    ]
  }
}
