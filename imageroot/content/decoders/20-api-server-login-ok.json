{
  "resource": {
    "name": "decoder/ns8-api-server-login-ok/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "NS8 cluster admin login",
      "description": "Successful logins to the NS8 cluster API",
      "author": "NethServer",
      "module": "api-server",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "_tmp_json.event.original": "contains(\"[AUTH] login-ok\")"
      }
    ],
    "normalize": [
      {
        "parse|_tmp_json.event.original": [
          "<~> login-ok user=<user.name> source=<source.ip> <~>"
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "authentication"
            ]
          },
          {
            "event.type": [
              "start"
            ]
          },
          {
            "event.action": "logged-in"
          },
          {
            "event.outcome": "success"
          }
        ]
      }
    ]
  }
}
