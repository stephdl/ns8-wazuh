{
  "resource": {
    "name": "decoder/ns8-webtop-login-ok/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "WebTop successful login",
      "description": "Logins accepted on WebTop, from its webtop-auth log line",
      "author": "NethServer",
      "module": "webtop",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "_line": "contains(\"webtop-auth: \")"
      },
      {
        "_line": "contains(\" action=LOGIN_SUCCESS\")"
      }
    ],
    "normalize": [
      {
        "parse|_line": [
          "<~>client=<source.ip> profile=<user.name>@<~>",
          "<~>client=<source.ip> profile=<user.name> <~>"
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "authentication"
            ]
          },
          {
            "event.type": [
              "start"
            ]
          },
          {
            "event.action": "logged-in"
          },
          {
            "event.outcome": "success"
          },
          {
            "service.type": "webtop"
          }
        ]
      }
    ]
  }
}
