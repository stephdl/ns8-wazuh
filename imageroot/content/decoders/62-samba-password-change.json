{
  "resource": {
    "name": "decoder/ns8-samba-password-change/0",
    "enabled": true,
    "parents": [
      "decoder/ns8-root/0"
    ],
    "metadata": {
      "title": "Samba password change",
      "description": "Passwords reset by an administrator or changed by their user",
      "author": "NethServer",
      "module": "samba",
      "compatibility": "NS8",
      "references": [
        "https://github.com/stephdl/ns8-wazuh"
      ],
      "versions": [
        "NS8 3.*"
      ]
    },
    "check": [
      {
        "_line": "contains(\"{\\\"timestamp\\\": \\\"\")"
      },
      {
        "_line": "contains(\"\\\"type\\\": \\\"passwordChange\\\"\")"
      }
    ],
    "normalize": [
      {
        "parse|_line": [
          "<~>]: <_samba_raw>"
        ]
      },
      {
        "map": [
          {
            "_samba_raw": "replace(\"\\n\", \"\")"
          },
          {
            "_samba": "parse_json($_samba_raw)"
          },
          {
            "service.type": "samba"
          }
        ]
      },
      {
        "map": [
          {
            "event.category": [
              "iam"
            ]
          },
          {
            "event.type": [
              "change"
            ]
          },
          {
            "event.reason": "$_samba.passwordChange.status"
          }
        ]
      },
      {
        "parse|_samba.passwordChange.dn": [
          "CN=<user.target.name>,<~>",
          "<~>"
        ]
      },
      {
        "check": "string_equal($_samba.passwordChange.action, 'Reset')",
        "map": [
          {
            "event.action": "password-reset"
          }
        ]
      },
      {
        "check": "string_equal($_samba.passwordChange.action, 'Change')",
        "map": [
          {
            "event.action": "password-changed"
          }
        ]
      }
    ]
  }
}
