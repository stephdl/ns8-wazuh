[Unit]
Description=Use the TLS certificate of Traefik for the agent listener when it is valid

[Service]
Type=oneshot
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
SyslogIdentifier=%N
ExecStart=-mkdir -vp certs
# A failure is ignored on purpose: the internal certificate keeps the manager running
ExecStart=-runagent install-listener-cert
