[Unit]
Description=Apply the log retention to the indexer policies
# Skip the run while the module is stopped
Requisite=wazuh-indexer.service
After=wazuh-indexer.service

[Service]
Type=oneshot
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
SyslogIdentifier=%N
ExecStart=runagent provision-retention
# The update hook may run before the indexer writes the templates of the new version: catch up here
ExecStart=runagent reset-stale-indices
