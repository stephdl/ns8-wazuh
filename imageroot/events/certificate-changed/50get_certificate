import json
import os
import sys
import agent

event = json.load(sys.stdin)
host = os.environ.get("TRAEFIK_HOST", "")

if not host or not agent.certificate_event_matches(event, host):
    sys.exit(0)  # not our certificate

# The exit status 0 means the certificate was replaced, 3 that the current one stays
if agent.run_helper("install-listener-cert").returncode == 0:
    agent.run_helper("fix-perms").check_returncode()
    # The manager has no documented reload for the agent listener certificate
    agent.run_helper("systemctl", "--user", "-T", "try-restart", "wazuh-manager.service").check_returncode()
