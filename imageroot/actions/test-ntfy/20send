import json
import os
import sys

import agent

import wazuh_ntfy

data = json.load(sys.stdin)
url = data["url"]
topic = data["topic"]
# The stored token only goes to the server it was stored for
token = data.get("token", "").strip() or wazuh_ntfy.token(url)


def fail(field, error):
    agent.set_status("validation-failed")
    # The value is left empty for the token: a secret must never be echoed back
    value = {"url": url, "topic": topic}.get(field, "")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


host = os.environ.get("TRAEFIK_HOST", "") or os.environ["MODULE_ID"]
try:
    wazuh_ntfy.send(url, token, topic, f"Wazuh on {host}", "Test message. The alerts will come here.",
                    click=f"https://{host}/" if os.environ.get("TRAEFIK_HOST") else "")
except wazuh_ntfy.NtfyError as error:
    print(agent.SD_WARNING + f"test message to {topic} failed: {error}", file=sys.stderr)
    # ntfy answers 401 to a token it does not know, and 403 to a topic the token or anonymous may not write to
    if error.status == 401:
        fail("token", "ntfy_token_unknown")
    if error.status == 403:
        fail("topic", "ntfy_topic_forbidden")
    if error.status == 429:
        fail("topic", "ntfy_rate_limited")
    fail("url", "ntfy_unreachable")
