set -e
exec 1>&2

# The services run since 50traefik called configure-module: load the snapshot, then reload the dashboard.
# The snapshot brings back the dashboards of the backup: load the ones of this version again.
runagent restore-snapshot
# The restored indices are older than the policies, which only catch the new ones
runagent provision-retention
systemctl --user try-restart wazuh-dashboard.service
runagent provision-dashboards || echo "Warning: the NS8 dashboards were not loaded"
