import json
import os
import sys

import agent
from wazuh_api import manager_api

data = json.load(sys.stdin)
host = os.environ.get("TRAEFIK_HOST", "")
agent.assert_exp(host != "", "the module is not configured yet")

body = {
    "address": host,
    "embed_ca": True,
    # Enough to enroll by hand or by script, short enough that a forgotten token dies soon
    "ttl": "1d",
    "max_uses": data.get("max_uses", 1),
}
if data.get("description"):
    body["description"] = data["description"]

# An agent that declares a group missing on the manager is refused at enrollment
# Every agent belongs to a customer: its login zones are set per customer
group = data["group"]
existing = manager_api("GET", f"groups?groups_list={group}")
if not existing.get("data", {}).get("affected_items"):
    created = manager_api("POST", "groups", {"group_id": group})
    if created.get("error", 1) != 0:
        print(agent.SD_ERR + f"group {group} refused: {created.get('detail') or created.get('message')}", file=sys.stderr)
        sys.exit(2)

response = manager_api("POST", "agents/enrollment-tokens", body)
if response.get("error", 1) != 0:
    print(agent.SD_ERR + f"enrollment token refused: {response.get('detail')}", file=sys.stderr)
    sys.exit(2)

json.dump(dict(response["data"], group=group), fp=sys.stdout)
