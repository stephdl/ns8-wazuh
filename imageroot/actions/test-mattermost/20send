import json
import os
import sys

import agent

import wazuh_mattermost

data = json.load(sys.stdin)
webhook = data.get("webhook", "").strip() or wazuh_mattermost.webhook()
channel = data.get("channel", "")
username = data.get("username", "")


def fail(field, error):
    agent.set_status("validation-failed")
    # The value is left empty for the webhook: a secret must never be echoed back
    value = {"channel": channel}.get(field, "")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


if not webhook:
    fail("webhook", "mattermost_webhook_required")
host = os.environ.get("TRAEFIK_HOST", "") or os.environ["MODULE_ID"]
try:
    wazuh_mattermost.send(webhook, f"Wazuh on {host}", "Test message. The alerts will come here.", "low",
                          f"https://{host}/" if os.environ.get("TRAEFIK_HOST") else "", channel, username)
except wazuh_mattermost.MattermostError as error:
    print(agent.SD_WARNING + f"test message to Mattermost failed: {error}", file=sys.stderr)
    # Mattermost answers 404 to a channel it does not know, and 400 to an unknown webhook or user
    if error.channel_unknown and channel:
        fail("channel", "mattermost_channel_unknown")
    if error.status in (400, 403, 404):
        fail("webhook", "mattermost_webhook_unknown")
    fail("webhook", "mattermost_unreachable")
