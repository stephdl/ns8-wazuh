import json
import os
import sys

data = json.load(sys.stdin)

# A secret never goes through agent.set_env(), which writes to Redis in plain text
path = "secrets/export.env"
if "export_token" in data:
    # A pasted token often ends with a line break, which would break the header
    data["export_token"] = data["export_token"].strip()
    if data["export_token"]:
        os.makedirs("secrets", mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(f"EXPORT_TOKEN={data['export_token']}\n")
    elif os.path.exists(path):
        os.remove(path)
