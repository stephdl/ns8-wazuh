set -e
exec 1>&2

# The manager does not start without the agent listener certificate, issued for the public host name.
# A new certificate needs a restart: leave a mark for 80start_services instead of restarting here.
before=$(sha256sum certs/remoted.pem 2>/dev/null || true)
REMOTED_HOST=$(jq -r .host) "${AGENT_INSTALL_DIR}/bin/renew-certs"
if [[ "$(sha256sum certs/remoted.pem 2>/dev/null)" != "${before}" ]]; then
    touch restart-needed
fi
