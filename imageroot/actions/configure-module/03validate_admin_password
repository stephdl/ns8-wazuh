import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from wazuh_password import password_error

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)
password = data.get("admin_password", "")

if password:
    error = password_error(password)
    if error:
        agent.set_status('validation-failed')
        # The value is left empty on purpose: a password must never be echoed back
        json.dump([{'field': 'admin_password', 'parameter': 'admin_password', 'value': '', 'error': error}], fp=sys.stdout)
        sys.exit(3)
