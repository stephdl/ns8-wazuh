set -e
exec 1>&2

# Load the NS8 decoders and rules once the indexer is healthy, run the rules on the events, set the retention, then load the dashboards
runagent provision-content
runagent provision-detector
runagent provision-retention
# A dashboard that does not load must not block the configuration
runagent provision-dashboards || echo "Warning: the NS8 dashboards were not loaded"
