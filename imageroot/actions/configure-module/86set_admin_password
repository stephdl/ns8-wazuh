import json
import subprocess
import sys

data = json.load(sys.stdin)
password = data.get("admin_password", "")

# Without a new password the current one is kept. It never goes through the environment
# of the module (Redis, in plain text): it is handed to the script on its standard input.
if password:
    subprocess.run(["runagent", "set-admin-password"], input=password + "\n", text=True,
                   stdout=sys.stderr, check=True)
