set -e
exec 1>&2

systemctl --user enable wazuh.service

# The other settings are applied through the APIs by the next steps: restart only when
# the pod is down or a certificate changed, a restart costs about two minutes
if [[ -f restart-needed ]] || ! systemctl --user is-active --quiet wazuh-indexer.service wazuh-manager.service wazuh-dashboard.service; then
    # Starting the pod does not start the children, so list them all, in order
    systemctl --user restart wazuh.service wazuh-indexer.service wazuh-manager.service wazuh-dashboard.service
    rm -f restart-needed
else
    echo "Services already running, no restart needed"
fi
