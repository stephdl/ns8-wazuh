import json
import os
import sys
import agent

data = json.load(sys.stdin)
agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_LETS_ENCRYPT", data.get("lets_encrypt", False))
agent.set_env("LDAP_DOMAIN", data.get("ldap_domain", ""))
agent.set_env("LDAP_ADMIN_GROUP", data.get("ldap_admin_group", ""))
agent.set_env("LDAP_READONLY_GROUP", data.get("ldap_readonly_group", ""))
agent.set_env("INDEX_UNCLASSIFIED_EVENTS", data.get("index_unclassified_events", False))
# A missing value keeps the current one: falling back to the default could delete logs
agent.set_env("LOG_RETENTION_DAYS", data.get("retention_days", os.environ.get("LOG_RETENTION_DAYS", 365)))
agent.set_env("EXPORT_URL", data.get("export_url", ""))
agent.set_env("NOTIFY_ENABLED", data.get("notify_enabled", False))
agent.set_env("NOTIFY_RECIPIENTS", ",".join(data.get("notify_recipients", [])))
agent.set_env("NOTIFY_SENDER", data.get("notify_sender", ""))
agent.set_env("NOTIFY_MIN_LEVEL", data.get("notify_min_level", "medium"))
agent.set_env("TELEGRAM_ENABLED", data.get("telegram_enabled", False))
agent.set_env("TELEGRAM_ADMIN_ENABLED", data.get("telegram_admin_enabled", False))
agent.set_env("TELEGRAM_CHAT_ID", data.get("telegram_chat_id", "").strip())
agent.set_env("NTFY_ENABLED", data.get("ntfy_enabled", False))
agent.set_env("NTFY_URL", data.get("ntfy_url", "https://ntfy.sh").strip().rstrip("/"))
agent.set_env("NTFY_TOPIC", data.get("ntfy_topic", "").strip())
