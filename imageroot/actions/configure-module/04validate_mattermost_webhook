import json
import os
import sys

import agent

import wazuh_mattermost

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)
# An omitted webhook keeps the saved one, an empty one removes it
webhook = data["mattermost_webhook"].strip() if "mattermost_webhook" in data else wazuh_mattermost.webhook()

if data.get("mattermost_enabled") and not webhook:
    agent.set_status('validation-failed')
    json.dump([{'field': 'mattermost_webhook', 'parameter': 'mattermost_webhook', 'value': '',
                'error': 'mattermost_webhook_required'}], fp=sys.stdout)
    sys.exit(3)
