import json
import os
import sys

import agent

import wazuh_talk

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)
# An omitted secret keeps the saved one, an empty one removes it
bot_secret = data["talk_secret"].strip() if "talk_secret" in data else wazuh_talk.secret()

if data.get("talk_enabled") and not bot_secret:
    agent.set_status('validation-failed')
    json.dump([{'field': 'talk_secret', 'parameter': 'talk_secret', 'value': '', 'error': 'talk_secret_required'}],
              fp=sys.stdout)
    sys.exit(3)
