import json
import os
import sys

import wazuh_telegram

data = json.load(sys.stdin)


def save_secret(field, path, key):
    """Write the token of a field to its file, remove the file when it is empty, keep it when omitted."""
    if field not in data:
        return
    # A pasted token often ends with a line break, which would break the request
    value = data[field].strip()
    if value:
        os.makedirs("secrets", mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(f"{key}={value}\n")
    elif os.path.exists(path):
        os.remove(path)


# A secret never goes through agent.set_env(), which writes to Redis in plain text
save_secret("export_token", "secrets/export.env", "EXPORT_TOKEN")
save_secret("telegram_token", wazuh_telegram.TOKEN_FILE, "TELEGRAM_TOKEN")
