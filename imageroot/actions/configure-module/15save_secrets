import fcntl
import json
import os
import sys

import agent

import wazuh_ntfy
import wazuh_secrets
import wazuh_telegram
import wazuh_zones

data = json.load(sys.stdin)


def save_secret(field, path, key):
    """Write the token of a field, remove it when empty, keep it when omitted."""
    if field in data:
        # A pasted token often ends with a line break, which would break the request
        wazuh_secrets.write(path, key, data[field].strip())


# A secret never goes through agent.set_env(), which writes to Redis in plain text
save_secret("export_token", "secrets/export.env", "EXPORT_TOKEN")
save_secret("telegram_token", wazuh_telegram.TOKEN_FILE, "TELEGRAM_TOKEN")
save_secret("ntfy_token", wazuh_ntfy.TOKEN_FILE, "NTFY_TOKEN")

# Without a bot no chat can be reached: the next token starts from empty fields, never from old chats
if not os.path.exists(wazuh_telegram.TOKEN_FILE):
    agent.set_env("TELEGRAM_ENABLED", False)
    agent.set_env("TELEGRAM_ADMIN_ENABLED", False)
    agent.set_env("TELEGRAM_CHAT_ID", "")
    with open(wazuh_zones.CUSTOMERS_FILE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        settings = wazuh_zones.load()
        chats = [c for c in settings["customers"].values() if c.get("telegram_chat_id") or c.get("telegram_enabled")]
        for customer in chats:
            customer.update(telegram_enabled=False, telegram_chat_id="", telegram_chat_title="")
        if chats:
            wazuh_zones.save(settings)
