import agent
import os

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "lets_encrypt": os.environ["TRAEFIK_LETS_ENCRYPT"] == "True",
    "host": os.environ["TRAEFIK_HOST"],
    "ldap_domain": os.environ.get("LDAP_DOMAIN", ""),
    "ldap_admin_group": os.environ.get("LDAP_ADMIN_GROUP", ""),
    "ldap_readonly_group": os.environ.get("LDAP_READONLY_GROUP", ""),
    "index_unclassified_events": os.environ.get("INDEX_UNCLASSIFIED_EVENTS") == "True",
    "export_url": os.environ.get("EXPORT_URL", ""),
    # Clones of instances configured before the switch existed sent emails as soon as a recipient was set
    "notify_enabled": os.environ.get("NOTIFY_ENABLED", str(bool(os.environ.get("NOTIFY_RECIPIENTS")))) == "True",
    "notify_recipients": [r for r in os.environ.get("NOTIFY_RECIPIENTS", "").split(",") if r],
    "notify_sender": os.environ.get("NOTIFY_SENDER", ""),
    "notify_min_level": os.environ.get("NOTIFY_MIN_LEVEL", "medium"),
    "telegram_enabled": os.environ.get("TELEGRAM_ENABLED") == "True",
    "telegram_admin_enabled": os.environ.get("TELEGRAM_ADMIN_ENABLED") == "True",
    "telegram_chat_id": os.environ.get("TELEGRAM_CHAT_ID", ""),
    "ntfy_enabled": os.environ.get("NTFY_ENABLED") == "True",
    "ntfy_url": os.environ.get("NTFY_URL", "https://ntfy.sh"),
    "ntfy_topic": os.environ.get("NTFY_TOPIC", ""),
    "mattermost_enabled": os.environ.get("MATTERMOST_ENABLED") == "True",
    "mattermost_channel": os.environ.get("MATTERMOST_CHANNEL", ""),
    "mattermost_username": os.environ.get("MATTERMOST_USERNAME", ""),
    "retention_days": int(os.environ.get("LOG_RETENTION_DAYS", "365")),
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
