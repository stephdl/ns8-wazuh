import fcntl
import json
import sys

import agent
import wazuh_zones
from wazuh_api import find_group, manager_api


def refuse(error):
    agent.set_status("validation-failed")
    json.dump([{"field": "name", "parameter": "name", "value": name, "error": error}], fp=sys.stdout)
    sys.exit(3)


def fail(message):
    print(agent.SD_ERR + message, file=sys.stderr)
    sys.exit(2)


data = json.load(sys.stdin)
name = data["name"]

try:
    group = find_group(name)
except RuntimeError as error:
    fail(str(error))

if group is not None:
    # Its agents would fall back to the group default and lose their login zones without a word
    if group.get("count", 0) > 0:
        refuse("customer_has_agents")
    response = manager_api("DELETE", f"groups?groups_list={name}")
    if response.get("error", 1) != 0 or response.get("data", {}).get("failed_items"):
        fail(f"cannot remove the customer {name}: "
             f"{response.get('detail') or response.get('message') or response.get('data', {}).get('failed_items')}")

# Also when the group is already gone: a removal cut after the delete is finished by running it again
with open(wazuh_zones.CUSTOMERS_FILE + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    settings = wazuh_zones.load()
    if settings["customers"].pop(name, None) is None and group is None:
        refuse("customer_not_found")
    wazuh_zones.save(settings)
    if agent.run_helper("runagent", "provision-zones").returncode != 0:
        fail(f"the customer {name} is removed but the engine still has its zones until the next configuration")

print(f"customer {name} removed", file=sys.stderr)
