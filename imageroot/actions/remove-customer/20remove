import fcntl
import json
import sys

import agent
import wazuh_zones
from wazuh_api import manager_api


def refuse(error):
    agent.set_status("validation-failed")
    json.dump([{"field": "name", "parameter": "name", "value": name, "error": error}], fp=sys.stdout)
    sys.exit(3)


data = json.load(sys.stdin)
name = data["name"]

response = manager_api("GET", f"groups?groups_list={name}")
groups = response.get("data", {}).get("affected_items", [])
if not groups:
    refuse("customer_not_found")
# Its agents would fall back to the group default and lose their login zones without a word
if groups[0].get("count", 0) > 0:
    refuse("customer_has_agents")

response = manager_api("DELETE", f"groups?groups_list={name}")
if response.get("error", 1) != 0 or response.get("data", {}).get("failed_items"):
    reason = response.get("detail") or response.get("message") or json.dumps(response.get("data", {}).get("failed_items"))
    print(agent.SD_ERR + f"cannot remove the customer {name}: {reason}", file=sys.stderr)
    sys.exit(2)

with open(wazuh_zones.CUSTOMERS_FILE + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    settings = wazuh_zones.load()
    if settings["customers"].pop(name, None) is not None:
        wazuh_zones.save(settings)
        agent.run_helper("runagent", "provision-zones").check_returncode()

print(f"customer {name} removed", file=sys.stderr)
