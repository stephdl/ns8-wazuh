import json
import sys

import agent
from wazuh_api import manager_api

data = json.load(sys.stdin)
agent_id = data["id"]
agent.assert_exp(agent_id != "000", "the manager is not an agent and cannot be removed")

# status=all and older_than=0s: delete the agent whatever its state, as the API asks both
response = manager_api("DELETE", f"agents?agents_list={agent_id}&status=all&older_than=0s")
failed = response.get("data", {}).get("failed_items", [])
if response.get("error", 1) != 0 or failed:
    reason = response.get("detail") or response.get("message") or json.dumps(failed)
    print(agent.SD_ERR + f"cannot remove the agent {agent_id}: {reason}", file=sys.stderr)
    sys.exit(2)

print(f"agent {agent_id} removed", file=sys.stderr)
