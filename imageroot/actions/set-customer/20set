import fcntl
import json
import sys

import agent
import wazuh_telegram
import wazuh_zones
from wazuh_api import manager_api

data = json.load(sys.stdin)
name = data["name"]

# Only a group that exists can match events: a typo would silently watch nothing
response = manager_api("GET", f"groups?groups_list={name}")
if name == "default" or not response.get("data", {}).get("affected_items"):
    agent.set_status("validation-failed")
    json.dump([{"field": "name", "parameter": "name", "value": name, "error": "customer_not_found"}], fp=sys.stdout)
    sys.exit(3)

chat_id = data.get("telegram_chat_id", "")
chat_title = ""
bot = wazuh_telegram.token()
# Only for the customers table: a chat the bot cannot see yet is shown by its ID
if chat_id and bot:
    try:
        chat = wazuh_telegram.known_chat(bot, chat_id)
        chat_title = chat["title"] if chat else ""
    except wazuh_telegram.TelegramError as error:
        print(agent.SD_WARNING + f"cannot read the name of Telegram chat {chat_id}: {error}", file=sys.stderr)

# Two saves at once would each write the file they read, and the first change would be lost
with open(wazuh_zones.CUSTOMERS_FILE + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    settings = wazuh_zones.load()
    settings["customers"][name] = {"zones": data.get("zones", []), "recipients": data.get("recipients", []),
                                   "telegram_enabled": data.get("telegram_enabled", False),
                                   "telegram_chat_id": chat_id, "telegram_chat_title": chat_title}
    wazuh_zones.save(settings)
    applied = agent.run_helper("runagent", "provision-zones").returncode == 0

# Saved anyway: the next configuration of the module applies it
if not applied:
    print(agent.SD_ERR + f"the zones of {name} are saved but the engine did not take them", file=sys.stderr)
    sys.exit(1)
