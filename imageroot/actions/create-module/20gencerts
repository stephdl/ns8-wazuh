set -e
exec 1>&2

# Internal CA for the pod and the agents. Agents pin it at enrollment, so it is never renewed
mkdir -p ca
chmod 0700 ca
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out ca/root-ca-key.pem
openssl req -x509 -new -key ca/root-ca-key.pem -days 3650 \
    -subj "/C=US/L=California/O=Wazuh/OU=Wazuh/CN=ns8-wazuh internal CA" -out ca/root-ca.pem

"${AGENT_INSTALL_DIR}/bin/renew-certs"
