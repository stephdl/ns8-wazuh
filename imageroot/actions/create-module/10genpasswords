import os
import secrets

# Wazuh requires one char of each class, and only these symbols: . , _ + : @ % ^ = ~ -
def new_password(prefix):
    return f"{prefix}1.{secrets.token_hex(12)}-Zz"

keys = {
    "WAZUH_INDEXER_ADMIN_PASSWORD": new_password("Ad"),
    "WAZUH_INDEXER_KIBANASERVER_PASSWORD": new_password("Kb"),
    "WAZUH_INDEXER_MANAGER_PASSWORD": new_password("Mg"),
    "WAZUH_MANAGER_API_PASSWORD": new_password("Ap"),
    "WAZUH_MANAGER_WUI_PASSWORD": new_password("Wu"),
}

# One file per component, as upstream does: each container only sees its own keys
components = {
    "indexer": ["WAZUH_INDEXER_ADMIN_PASSWORD", "WAZUH_INDEXER_KIBANASERVER_PASSWORD", "WAZUH_INDEXER_MANAGER_PASSWORD"],
    "manager": ["WAZUH_INDEXER_MANAGER_PASSWORD", "WAZUH_MANAGER_API_PASSWORD", "WAZUH_MANAGER_WUI_PASSWORD"],
    "dashboard": ["WAZUH_INDEXER_KIBANASERVER_PASSWORD", "WAZUH_MANAGER_WUI_PASSWORD"],
}

os.makedirs("secrets", mode=0o700, exist_ok=True)
for component, names in components.items():
    path = f"secrets/{component}.env"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for name in names:
            f.write(f"{name}={keys[name]}\n")
