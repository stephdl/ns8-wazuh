{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Customers",
    "$id": "http://nethserver.org/json-schema/task/output/wazuh/list-customers",
    "description": "The customers, that is the Wazuh agent groups, with their login zones and alert recipients",
    "examples": [
        {
            "customers": [
                {
                    "name": "acme",
                    "agents": 3,
                    "zones": [
                        "@EU",
                        "CA"
                    ],
                    "recipients": [
                        "soc@acme.example"
                    ],
                    "telegram_chat_id": "-1001234567890"
                }
            ],
            "countries": [
                "BE",
                "CA",
                "FR"
            ],
            "continents": {
                "EU": "Europe"
            }
        }
    ],
    "type": "object",
    "required": [
        "customers",
        "countries",
        "continents"
    ],
    "properties": {
        "customers": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "agents",
                    "zones",
                    "recipients",
                    "telegram_chat_id"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "agents": {
                        "type": "integer",
                        "description": "Agents enrolled in this customer"
                    },
                    "zones": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "recipients": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "telegram_chat_id": {
                        "type": "string",
                        "description": "Telegram chat of the customer, empty when none"
                    }
                }
            }
        },
        "countries": {
            "type": "array",
            "description": "ISO 3166 codes a zone may use",
            "items": {
                "type": "string"
            }
        },
        "continents": {
            "type": "object",
            "description": "Continent codes a zone may use with @, and their names",
            "additionalProperties": {
                "type": "string"
            }
        }
    }
}
