import json
import sys

import agent

import wazuh_telegram

data = json.load(sys.stdin)
token = data.get("token", "").strip() or wazuh_telegram.token()


def fail(error):
    agent.set_status("validation-failed")
    # The value is left empty: a secret must never be echoed back
    json.dump([{"field": "token", "parameter": "token", "value": "", "error": error}], fp=sys.stdout)
    sys.exit(3)


if not token:
    fail("telegram_token_required")
try:
    chats = wazuh_telegram.recent_chats(token)
except wazuh_telegram.TelegramError as error:
    print(agent.SD_WARNING + f"cannot list the Telegram chats: {error}", file=sys.stderr)
    if error.status in (401, 404):
        fail("telegram_token_invalid")
    # 409: the bot already gives its updates to a webhook, getUpdates is refused
    if error.status == 409:
        fail("telegram_bot_has_webhook")
    fail("telegram_unreachable")
json.dump({"chats": chats}, fp=sys.stdout)
