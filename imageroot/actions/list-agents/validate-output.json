{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Enrolled agents",
    "$id": "http://nethserver.org/json-schema/task/output/wazuh/list-agents",
    "description": "The agents known to the manager",
    "examples": [
        {
            "agents": [
                {
                    "id": "001",
                    "name": "web1",
                    "ip": "192.0.2.10",
                    "status": "active",
                    "version": "v5.0.0",
                    "os": "Rocky Linux 9.8 (Blue Onyx)",
                    "last_keep_alive": "2026-10-08T16:40:00+00:00",
                    "date_add": "2026-10-08T15:10:00+00:00",
                    "groups": [
                        "default"
                    ],
                    "setup": "1.2.0"
                }
            ],
            "manager_version": "v5.0.0",
            "package_version": "5.0.0-rc1",
            "setup": "1.2.0",
            "script_ref": "1.2.0"
        }
    ],
    "type": "object",
    "required": [
        "agents"
    ],
    "properties": {
        "agents": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "ip": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "description": "active, disconnected, pending or never_connected"
                    },
                    "version": {
                        "type": "string"
                    },
                    "os": {
                        "type": "string"
                    },
                    "last_keep_alive": {
                        "type": "string"
                    },
                    "date_add": {
                        "type": "string"
                    },
                    "groups": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "setup": {
                        "type": "string",
                        "description": "AGENT_SETUP of the install script that last ran on the agent, empty when unknown"
                    }
                }
            }
        },
        "manager_version": {
            "type": "string",
            "title": "Server version",
            "description": "Version of the Wazuh manager, in the same form as the agent versions"
        },
        "package_version": {
            "type": "string",
            "title": "Package version",
            "description": "Version to pass to the install script to update an agent"
        },
        "setup": {
            "type": "string",
            "title": "Agent setup",
            "description": "AGENT_SETUP of the install script shipped with this module"
        },
        "script_ref": {
            "type": "string",
            "title": "Script reference",
            "description": "Git tag or branch of the install script to download"
        }
    }
}
