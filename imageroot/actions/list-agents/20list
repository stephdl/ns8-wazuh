import json
import os
import re
import sys

import agent
from wazuh_api import api, manager_api

FIELDS = "id,name,ip,registerIP,status,version,os.name,os.platform,os.version,lastKeepAlive,dateAdd,group"

PAGE = 500

items = []
while True:
    response = manager_api("GET", f"agents?select={FIELDS}&limit={PAGE}&offset={len(items)}&sort=%2Bname")
    if response.get("error", 1) != 0:
        print(agent.SD_ERR + f"cannot list the agents: {response.get('detail')}", file=sys.stderr)
        sys.exit(2)
    page = response["data"]["affected_items"]
    items += page
    if len(page) < PAGE or len(items) >= response["data"]["total_affected_items"]:
        break


def expected_setup():
    try:
        with open(os.path.join(os.environ.get("AGENT_INSTALL_DIR", "."), "etc", "install-agent.sh")) as f:
            match = re.search(r'^AGENT_SETUP="([^"]+)"', f.read(), re.M)
    except OSError:
        return ""
    return match.group(1) if match else ""


# Each agent reports its configuration to the indexer at its start and every hour,
# the install script leaves its AGENT_SETUP there as the alias of a command
def agent_setups():
    answer = api("GET", "wazuh-agent-config/_search?size=10000&_source=wazuh.agent.id,"
                 "wazuh.agent.configuration.content.logcollector.localfile.alias")
    if "error" in answer:
        # No agent reported its configuration yet on a new server
        if answer["error"].get("type") == "index_not_found_exception":
            return {}
        raise RuntimeError(answer["error"].get("reason") or answer["error"])
    setups = {}
    for hit in answer.get("hits", {}).get("hits", []):
        wazuh_agent = hit["_source"].get("wazuh", {}).get("agent", {})
        content = wazuh_agent.get("configuration", {}).get("content", {})
        for localfile in content.get("logcollector", {}).get("localfile", []):
            alias = localfile.get("alias", "")
            if alias.startswith("ns8-setup:"):
                setups[wazuh_agent.get("id") or hit["_id"]] = alias.partition(":")[2]
    return setups


def version_tuple(version):
    return tuple(int(part) for part in re.findall(r"\d+", version))


# Only the Linux agents run the install script: Windows and macOS are installed by hand
def is_setup_outdated(item, setup):
    platform = (item.get("os") or {}).get("platform", "")
    if setups is None or not expected or not item.get("version") or platform in ("windows", "darwin"):
        return False
    return not setup or version_tuple(setup) < version_tuple(expected)


# The image tag names the script of this module, a branch build falls back to main
def script_ref():
    tag = os.environ.get("IMAGE_URL", "").rpartition("/")[2].partition(":")[2]
    return tag if re.fullmatch(r"\d+\.\d+\.\d+(-[\w.]+)?", tag) else "main"


expected = expected_setup()
try:
    setups = agent_setups()
except RuntimeError as error:
    # Unknown is not outdated: no agent gets the tag, the list of the agents stays
    print(agent.SD_WARNING + f"cannot read the agent configurations: {error}", file=sys.stderr)
    setups = None

agents = []
for item in items:
    os_info = item.get("os") or {}
    agents.append({
        "id": item["id"],
        "name": item.get("name", ""),
        # The manager keeps the address seen at the enrollment when the agent did not give one
        "ip": item.get("ip") or item.get("registerIP") or "",
        "status": item.get("status", ""),
        "version": item.get("version", ""),
        "os": " ".join(part for part in (os_info.get("name"), os_info.get("version")) if part),
        "last_keep_alive": item.get("lastKeepAlive", ""),
        "date_add": item.get("dateAdd", ""),
        "groups": item.get("group") or [],
        "setup": (setups or {}).get(item["id"], ""),
        "setup_outdated": is_setup_outdated(item, (setups or {}).get(item["id"], "")),
    })

# Older managers listed themselves with the id 000: it is not an agent
agents = [a for a in agents if a["id"] != "000"]
api_version = manager_api("GET", "").get("data", {}).get("api_version", "")
json.dump({
    "agents": agents,
    # Same form as the agent versions, to compare them in the UI
    "manager_version": f"v{api_version}" if api_version else "",
    # The install script takes the tag of the image, the package versions differ (5.0.0-rc1 is 5.0.0-1)
    "package_version": os.environ.get("WAZUH_MANAGER_IMAGE", "").rpartition(":")[2],
    "setup": expected,
    "script_ref": script_ref(),
}, fp=sys.stdout)
